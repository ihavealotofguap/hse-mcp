# Корпоративная учётная запись ВШЭ (login@edu.hse.ru + пароль).
# Используется для RUZ (поиск по email, авторизация не требуется),
# SmartLMS (edu.hse.ru) и ЕЛК (lk.hse.ru) через Playwright.
HSE_EMAIL=login@edu.hse.ru
HSE_PASSWORD=

# Необязательно: показывать окно браузера при Playwright-логине (для отладки).
# По умолчанию — headless (без окна).
HSE_BROWSER_HEADLESS=true

# Необязательно: папка «исходящих» — отсюда (и только отсюда) берутся файлы для сдачи заданий.
# Абсолютный путь или относительно корня проекта. По умолчанию — storage/outbox.
# HSE_OUTBOX_DIR=storage/outbox

# Необязательно: включает тулы, которые отправляют данные в SmartLMS/ЕЛК: lms_submit_assignment,
# lms_delete_submission и elk_order_certificate (заказ справки в ЕЛК НЕОБРАТИМ: отмены заявки нет).
# Без этой строки тулов записи у сервера нет вообще. Значение ровно true.
# HSE_ENABLE_WRITES=true

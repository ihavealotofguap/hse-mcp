{
  "name": "hsemcp",
  "version": "0.1.0",
  "description": "MCP server for HSE (NIU VShE) student infrastructure: SmartLMS, ELK",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "bin": {
    "hsemcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "npm run build && node --import ./test/setup-env.mjs --test \"test/*.test.mjs\"",
    "credentials:set": "node dist/cli/credentials.js set",
    "credentials:clear": "node dist/cli/credentials.js clear",
    "credentials:status": "node dist/cli/credentials.js status"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dotenv": "^16.4.5",
    "playwright": "^1.51.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "typescript": "^5.5.4"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "^2.1.1"
  }
}

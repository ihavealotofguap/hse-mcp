{
  "name": "hse-mcp",
  "version": "0.1.1",
  "description": "MCP server for HSE University (NIU VShE) student services: SmartLMS (edu.hse.ru) and the personal account (lk.hse.ru)",
  "mcpName": "io.github.ihavealotofguap/hse-mcp",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "hse",
    "smartlms",
    "moodle",
    "claude"
  ],
  "homepage": "https://github.com/ihavealotofguap/hse-mcp#readme",
  "bugs": {
    "url": "https://github.com/ihavealotofguap/hse-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ihavealotofguap/hse-mcp.git"
  },
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "bin": {
    "hse-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "npm run build && node --import ./test/setup-env.mjs --test \"test/*.test.mjs\"",
    "credentials:set": "node dist/cli/credentials.js set",
    "credentials:clear": "node dist/cli/credentials.js clear",
    "credentials:status": "node dist/cli/credentials.js status",
    "prepublishOnly": "npm test",
    "pack:mcpb": "npm run build && node scripts/pack-mcpb.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^18.0.9",
    "playwright": "^1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@biomejs/biome": "2.6.3",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "^2.1.1"
  }
}

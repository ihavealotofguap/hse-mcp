{
  "name": "hsemcp",
  "version": "0.1.0",
  "description": "MCP server for HSE University (NIU VShE) student services: SmartLMS (edu.hse.ru) and the personal account (lk.hse.ru)",
  "mcpName": "io.github.ihavealotofguap/hsemcp",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "hse",
    "smartlms",
    "moodle",
    "claude"
  ],
  "homepage": "https://github.com/ihavealotofguap/hsemcp#readme",
  "bugs": {
    "url": "https://github.com/ihavealotofguap/hsemcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ihavealotofguap/hsemcp.git"
  },
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "bin": {
    "hsemcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "npm run build && node --import ./test/setup-env.mjs --test \"test/*.test.mjs\"",
    "credentials:set": "node dist/cli/credentials.js set",
    "credentials:clear": "node dist/cli/credentials.js clear",
    "credentials:status": "node dist/cli/credentials.js status",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dotenv": "^16.4.5",
    "playwright": "^1.51.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "^22.20.5",
    "typescript": "^5.5.4"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "^2.1.1"
  }
}
